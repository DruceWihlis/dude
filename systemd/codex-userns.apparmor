# Ubuntu 24.04+ restricts unprivileged user namespaces, which breaks the Codex bubblewrap sandbox
# when started from systemd. This profile allows them for the Codex binary only.
#
# Replace CODEX_PATH with the output of `command -v codex` (globs are allowed), then:
#   sudo cp systemd/codex-userns.apparmor /etc/apparmor.d/codex-userns
#   sudo apparmor_parser -r /etc/apparmor.d/codex-userns
abi <abi/4.0>,
include <tunables/global>

profile codex-userns CODEX_PATH flags=(unconfined) {
  userns,
}
