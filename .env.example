# Telegram bot from @BotFather. Send /start to it once; the chat ID is detected automatically.
TG_BOT_TOKEN=
# Optional: set explicitly if more than one chat has messaged the bot.
TG_CHAT_ID=

# Agent: codex, claude or auto (Codex if installed, otherwise Claude Code).
DUDE_AGENT=auto
# Empty model means the CLI default. Cheap and good enough: gpt-6-luna (Codex) or
# claude-haiku-5-5 (Claude Code). See "Keep it cheap" in the README.
DUDE_MODEL=
# low, medium, high (Claude also: xhigh, max). "none" omits the flag.
DUDE_EFFORT=low
# Claude Code only: hard spending cap per run, in USD. Empty means no cap.
DUDE_MAX_BUDGET_USD=

# Schedule. Empty DUDE_TZ means the system timezone.
DUDE_TZ=
DUDE_SCAN_HOUR=5
DUDE_CATCHUP_HOUR=18
DUDE_SCAN_MINUTES=50
# ISO weekdays for the company watchlist scan (1 = Monday). Empty disables it.
DUDE_COMPANY_DAYS=1,3,5

# Optional paths when the CLIs are not on PATH.
CODEX_BIN=
CLAUDE_BIN=
